# systemd unit: Rift backend (update server + admin panel). It also supervises the Minecraft server process.
# Install: copy to /etc/systemd/system/, adjust paths/user, then: systemctl enable --now rift-backend
[Unit]
Description=Spell and Iron Rift backend and server supervisor
After=network-online.target
Wants=network-online.target

[Service]
User=rift
Group=rift
WorkingDirectory=/opt/rift/backend
Environment=NODE_ENV=production
Environment=RIFT_BIND=127.0.0.1
Environment=RIFT_PORT=8080
Environment=RIFT_PUBLIC_URL=https://rift.example.org
Environment=RIFT_DATA_DIR=/var/lib/rift
Environment=RIFT_SERVER_DIR=/opt/rift/server/runtime
Environment=RIFT_MC_HOST=play.example.org
Environment=RIFT_MC_PORT=25565
Environment=RIFT_TRUST_PROXY=1
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
# Give the Minecraft server time to save the world on shutdown.
TimeoutStopSec=120
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rift /opt/rift/server/runtime

[Install]
WantedBy=multi-user.target
